{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddalabs/ravens-apps/schema/manifest.schema.json",
  "title": "Ravens app manifest",
  "description": "Describes a Midnight app and the actions Ravens agents may prepare for it. v0: proof of concept.",
  "type": "object",
  "required": ["id", "name", "version", "networks", "actions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "networks": {
      "description": "Networks the app is deployed on, with its contract address on each. Built-in actions (no contract) use null.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["contract"],
        "additionalProperties": false,
        "properties": {
          "contract": { "type": ["string", "null"] },
          "verifierKeyHash": { "type": "string", "description": "Pins the contract code the manifest was reviewed against." }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "kind", "params"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "description": { "type": "string" },
          "kind": { "enum": ["transfer", "contract_call"] },
          "circuit": { "type": "string", "description": "Circuit to call, for kind contract_call." },
          "params": { "type": "object", "description": "JSON Schema for the action's parameters." },
          "movesFunds": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
